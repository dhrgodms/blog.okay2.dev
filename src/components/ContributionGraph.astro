---
interface Props {
	dates: Date[];
	weeks?: number;
}

const { dates, weeks = 26 } = Astro.props;

const CELL = 10;
const GAP = 3;
const gridWidth = weeks * (CELL + GAP) - GAP;

function pad(n: number) {
	return String(n).padStart(2, '0');
}
function dateKey(d: Date) {
	return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}
function levelFor(count: number) {
	if (count <= 0) return 0;
	if (count === 1) return 1;
	if (count === 2) return 2;
	if (count <= 4) return 3;
	return 4;
}

const counts = new Map<string, number>();
for (const d of dates) {
	const key = dateKey(d);
	counts.set(key, (counts.get(key) ?? 0) + 1);
}

const today = new Date();
today.setHours(0, 0, 0, 0);

const recentSunday = new Date(today);
recentSunday.setDate(today.getDate() - today.getDay());

const gridStart = new Date(recentSunday);
gridStart.setDate(gridStart.getDate() - (weeks - 1) * 7);

const columns = Array.from({ length: weeks }, (_, w) =>
	Array.from({ length: 7 }, (_, d) => {
		const date = new Date(gridStart);
		date.setDate(gridStart.getDate() + w * 7 + d);
		const count = counts.get(dateKey(date)) ?? 0;
		return {
			date,
			count,
			level: levelFor(count),
			isFuture: date > today,
		};
	}),
);

const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'numeric' });
const monthLabels = columns.map((col, i) => {
	const firstDay = col[0].date;
	if (i === 0) return monthFormatter.format(firstDay);
	const prevFirstDay = columns[i - 1][0].date;
	return firstDay.getMonth() !== prevFirstDay.getMonth() ? monthFormatter.format(firstDay) : '';
});

const tooltipFormatter = new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric', weekday: 'short' });

const daysInGrid = columns.flat();
const totalPosts = daysInGrid.reduce((sum, day) => sum + day.count, 0);
const activeDays = daysInGrid.filter((day) => day.count > 0).length;
---

<div class="contribution-graph">
	<p class="stat">
		최근 {weeks}주 동안 <strong>{totalPosts}개</strong>의 글 · <strong>{activeDays}일</strong> 작성
	</p>
	<div class="graph-scroll">
		<div class="graph" style={`width: ${gridWidth}px`}>
			<div class="months">
				{monthLabels.map((label) => <span class="month-label">{label}</span>)}
			</div>
			<div class="weeks">
				{
					columns.map((col) => (
						<div class="week">
							{col.map((day) => (
								<span
									class:list={['day', { future: day.isFuture }]}
									data-level={day.isFuture ? undefined : day.level}
									title={day.isFuture ? undefined : `${tooltipFormatter.format(day.date)} · ${day.count}개`}
								/>
							))}
						</div>
					))
				}
			</div>
		</div>
	</div>
	<div class="legend">
		<span>적음</span>
		<span class="day" data-level="0"></span>
		<span class="day" data-level="1"></span>
		<span class="day" data-level="2"></span>
		<span class="day" data-level="3"></span>
		<span class="day" data-level="4"></span>
		<span>많음</span>
	</div>
</div>

<style>
	.contribution-graph {
		margin-bottom: 2.5em;
	}
	.stat {
		margin: 0 0 0.6em 0;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.stat strong {
		color: rgb(var(--black));
	}
	.graph-scroll {
		overflow-x: auto;
		padding-bottom: 0.2em;
		padding-right: 20px;
	}
	.graph {
		display: inline-flex;
		flex-direction: column;
		gap: 0.3em;
	}
	.months {
		display: flex;
	}
	.month-label {
		flex: 0 0 13px;
		width: 13px;
		min-width: 0;
		font-size: 0.7em;
		color: rgb(var(--gray));
		white-space: nowrap;
		overflow: visible;
	}
	.weeks {
		display: flex;
		gap: 3px;
	}
	.week {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.day {
		width: 10px;
		height: 10px;
		border-radius: 2px;
		background: rgb(var(--gray-light));
	}
	.day[data-level='1'] {
		background: rgba(var(--accent-rgb), 0.35);
	}
	.day[data-level='2'] {
		background: rgba(var(--accent-rgb), 0.55);
	}
	.day[data-level='3'] {
		background: rgba(var(--accent-rgb), 0.8);
	}
	.day[data-level='4'] {
		background: rgb(var(--accent-rgb));
	}
	.day.future {
		background: transparent;
	}
	.legend {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-top: 0.5em;
		font-size: 0.75em;
		color: rgb(var(--gray));
	}
	.legend .day {
		width: 10px;
		height: 10px;
	}
</style>
